{
    "name": "casasoft/casawp",
    "description": "casawp WordPress Plugin",
    "license": "",
    "keywords": [
        "casawp",
        "casasoft"
    ],
    "homepage": "http://framework.zend.com/",
    "repositories": [
        {
            "type": "composer",
            "url": "./distribution/wp.casasoft.com/casawp/compatibility",
            "only": [
                "casasoft/casamodules",
                "laminas/laminas-eventmanager",
                "laminas/laminas-log",
                "laminas/laminas-mvc",
                "laminas/laminas-serializer",
                "laminas/laminas-view"
            ]
        }
    ],
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0",
        "laminas/laminas-loader": "^2.0",
        "laminas/laminas-mvc": "^3.7",
        "laminas/laminas-i18n": "^2.0",
        "laminas/laminas-modulemanager": "^2.16",
        "laminas/laminas-view": "^2.0",
        "laminas/laminas-serializer": "^2.0",
        "laminas/laminas-log": "^2.0",
        "laminas/laminas-servicemanager": "^3.23",
        "laminas/laminas-escaper": "^2.0",
        "casasoft/casamodules": "dev-casawp",
        "laminas/laminas-mvc-i18n": "^1.9",
        "laminas/laminas-form": "^3.21"
    },
    "autoload": {
        "psr-4": {
            "casawp\\": "classes/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "post-install-cmd": "@php distribution/wp.casasoft.com/casawp/compatibility/apply-patches.php",
        "post-update-cmd": "@php distribution/wp.casasoft.com/casawp/compatibility/apply-patches.php"
    }
}
